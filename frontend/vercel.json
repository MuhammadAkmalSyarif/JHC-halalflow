{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "https://qptzbrbtzfnjuvurkbhr.supabase.co/storage/v1/object/public/halal-flow-uploads/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|logo\\.jpg|logo \\(2\\)\\.jpg|nama-bahan\\.xlsx|nama_produk\\.xlsx).*)",
      "destination": "/index.html"
    }
  ]
}
