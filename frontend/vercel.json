{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/send-email"
    },
    {
      "source": "/api/:path*",
      "destination": "https://jhc-halalflow-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://jhc-halalflow-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|logo\\.jpg|logo \\(2\\)\\.jpg|nama-bahan\\.xlsx|nama_produk\\.xlsx).*)",
      "destination": "/index.html"
    }
  ]
}
