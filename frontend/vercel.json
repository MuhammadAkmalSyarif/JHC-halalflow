{
  "rewrites": [
    {
      "source": "/api/send-email",
      "destination": "/api/send-email"
    },
    {
      "source": "/api/:path*",
      "destination": "https://jhc-halalflow-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://jhc-halalflow-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|favicon\\.ico|logo\\.jpg).*)",
      "destination": "/index.html"
    }
  ]
}
